# Copy to .env only if you want to override the defaults.
# LedgerLens also reads the same values from the process environment.

# Ollama
LEDGERLENS_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434

# OCR. Leave empty to auto-detect tesseract on PATH or in Program Files.
TESSERACT_CMD=

# Optional: move every generated artifact somewhere else.
# LEDGERLENS_DATA_DIR=./data
